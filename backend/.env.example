# ─── Application ──────────────────────────────
APP_NAME=Sport+
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
API_V1_PREFIX=/api/v1

# ─── Database ─────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sportplus_user:sportplus_pass@localhost:5432/sportplus

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ──────────────────────────────────────
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Eskiz SMS ────────────────────────────────
ESKIZ_EMAIL=your-email@example.com
ESKIZ_PASSWORD=your-eskiz-password
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# ─── Click Payment ────────────────────────────
CLICK_MERCHANT_ID=your-merchant-id
CLICK_SERVICE_ID=your-service-id
CLICK_SECRET_KEY=your-click-secret-key

# ─── Payme Payment ────────────────────────────
PAYME_MERCHANT_ID=your-merchant-id
PAYME_MERCHANT_KEY=your-payme-merchant-key

# ─── Telegram Bot ─────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── MinIO / S3 ──────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sportplus-media

# ─── RabbitMQ ─────────────────────────────────
RABBITMQ_URL=amqp://sportplus:sportplus_pass@localhost:5672/

# ─── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Booking ──────────────────────────────────
BOOKING_HOLD_DURATION_SECONDS=600
